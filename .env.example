# Alvora Cyber — environment variables
# Copy this file to .env and fill in the values you need.
# All keys are optional unless marked required; the app falls back
# to free/local providers when a paid key is absent.

# ── LLM Providers ────────────────────────────────────────────────────────────
# Anthropic Claude (paid backup AI — console.anthropic.com/settings/keys)
ANTHROPIC_KEY=

# NVIDIA NIM (build.nvidia.com — free tier available)
NVIDIA_NIM_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_NIM_DEEP_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# OpenRouter (openrouter.ai — free Nemotron endpoint used by default)
OPENROUTER_KEY=
OPENROUTER_DEEP_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Local Ollama (http://127.0.0.1:11434 — no key needed)
OLLAMA_HOST=http://127.0.0.1:11434
ALVORA_OLLAMA_MODEL=

# Override provider chains (comma-separated: ollama,nvidia,anthropic)
ALVORA_LLM_FAST=
ALVORA_LLM_DEEP=

# ── Threat Intelligence APIs ──────────────────────────────────────────────────
# AbuseIPDB (abuseipdb.com — free tier: 1,000 checks/day)
ABUSEIPDB_KEY=

# abuse.ch (no key required for most endpoints)
ABUSECH_KEY=

# ── App Settings ──────────────────────────────────────────────────────────────
# Internal API token used between Electron and the backend (generated at startup)
ALVORA_API_TOKEN=

# Port the backend listens on (default 7429)
ALVORA_API_PORT=7429

# Data directory for vault, cache, and logs (defaults to ~/.alvora-cyber)
ALVORA_DATA_DIR=

# Classifier settings
ALVORA_CLASSIFIER_DIR=
ALVORA_CLASSIFIER_THRESHOLD=
ALVORA_CLASSIFIER_VETO=

# AI scan budget in ms per request
ALVORA_AI_SCAN_BUDGET_MS=

# Comma-separated paths to monitor for downloads / persistence
ALVORA_DOWNLOADS_DIRS=
ALVORA_PERSISTENCE_DIRS=

# Network learning warmup hours
ALVORA_NET_LEARNING_HOURS=
